{
  "kinds": {},
  "maxCommitLines": 400,
  "maxCommitFiles": 15,
  "ignore": [
    "node_modules/", "dist/", "build/", "vendor/", ".venv/", "__pycache__/",
    ".lock", "-lock.json", "lock.yaml", ".min.js", ".map", ".snap", ".svg", ".png", ".jpg"
  ],
  "patterns": [
    {
      "regex": "catch\\s*(\\([^)]*\\))?\\s*\\{\\s*\\}",
      "message": "빈 catch: 예외를 삼키지 말고 처리하거나 그대로 올린다"
    },
    {
      "regex": "except[^:\\n]*:\\s*pass\\b",
      "message": "except: pass: 예외를 삼키지 말고 처리하거나 그대로 올린다"
    },
    {
      "regex": "@ts-ignore|@ts-nocheck|eslint-disable|# type: ignore|\\bnoqa\\b",
      "message": "검사 끄기: 경고를 끄지 말고 원인을 고친다"
    }
  ],
